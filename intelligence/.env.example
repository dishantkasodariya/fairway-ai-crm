# Google Places API (company discovery)
PLACES_API=your_google_places_api_key_here

# Groq (dev/test LLM provider — free tier, used by AgentRunner when LLM_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here

# Serper (Google search results as an agent tool — https://serper.dev)
SERPER_API_KEY=your_serper_api_key_here

# Postgres connection string
DATABASE_URL=postgresql+psycopg2://fairway:fairway@localhost:5439/fairway

# Which LLM provider AgentRunner uses: "groq" (dev/free), "bedrock" or "openai" (prod)
LLM_PROVIDER=groq

# Observability
LOG_LEVEL=INFO
OTEL_ENABLED=true
OTEL_SERVICE_NAME=fairway-intelligence
# Defaults to the Jaeger instance already running locally (UI: http://localhost:16686).
# Point this at a reachable OTLP collector for staging/prod.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# AWS Bedrock (prod only, LLM_PROVIDER=bedrock) — picked up via standard boto3
# credential chain (env vars below, ~/.aws/credentials, or an instance/task role).
# No custom var names needed; listed here for reference only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# Bedrock model IDs — verify these against your account's enabled model access
# in the Bedrock console (region-specific inference profile IDs, change over time).
# Bulk = the search/extract grind (most agent steps, optimize for cost).
# Judgment = reconciling conflicting numbers / final synthesis (optimize for accuracy).
BEDROCK_MODEL_ID_BULK=apac.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_ID_JUDGMENT=apac.anthropic.claude-sonnet-5-20250929-v1:0

# OpenAI (prod option, LLM_PROVIDER=openai) — Responses API, stateless (store=false).
# Pay-as-you-go API credits from platform.openai.com (a ChatGPT subscription does NOT include API use).
OPENAI_API_KEY=
# Blank = built-in default. BULK = classification/revenue/signals, JUDGMENT = outreach drafts.
OPENAI_MODEL_BULK=
OPENAI_MODEL_JUDGMENT=
# Reasoning effort for GPT-6/5.x models (e.g. minimal, low, medium, high). Higher = more output tokens = more cost
OPENAI_REASONING_EFFORT=low

# API auth — clients (e.g. the CRM) must send this as `X-API-Key`
API_KEY=change_me

# Set this to "production" on the real deployment. Until then, "fairway_intelligence_dev_key"
# is also accepted as X-API-Key (convenience for local dev) — setting ENVIRONMENT=production
# closes that off so only the real API_KEY above works.
ENVIRONMENT=development

# Apollo.io (contact enrichment — People Search/Match require a paid plan;
# Organization Enrichment works on Free tier)
APOLLO_API_KEY=your_apollo_api_key_here

# Intelligence pipeline: after a search, revenue -> rank (business-type fit x revenue)
# -> signals in batches of SIGNALS_BATCH_SIZE until done (or SIGNALS_MAX_PER_RUN; 0 = all)
# -> Apollo contacts for the CONTACTS_TOP_N best-scored companies.
# Parallel research agents (each makes several LLM + search calls). Free LLM tiers: 1-2. Paid OpenAI: 6-10.
LLM_CONCURRENCY=2
SIGNALS_BATCH_SIZE=100
SIGNALS_MAX_PER_RUN=0
CONTACTS_TOP_N=25
# Business types worth researching, comma-separated (exact names from classification/rules.py).
# Anything in neither list is skipped (no revenue/signals spend). Blank = built-in defaults.
SUITABLE_BUSINESS_TYPES_PRIMARY=
SUITABLE_BUSINESS_TYPES_SECONDARY=
