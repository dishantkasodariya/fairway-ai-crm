# ==============================================================================
# FAIRWAY CRM BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL CONFIGURATION (Use this in backend/.env for localhost)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Local PostgreSQL Database (Default port 5432)
DATABASE_URL=postgresql://postgres:your_local_password@localhost:5432/fairway_crm?schema=public

# JWT Secret for local dev
JWT_SECRET=your_jwt_secret_min_32_characters_here
JWT_EXPIRES_IN=7d

# Fairway Company Intelligence API (run separately from /intelligence)
INTELLIGENCE_API_URL=http://localhost:8000
INTELLIGENCE_API_KEY=fairway_intelligence_dev_key  # must match API_KEY in intelligence/.env

# Background jobs
TODAY_DIGEST_ENABLED=true
AI_SIGNALS_WATCHER_ENABLED=true
DISCOVERY_CRON_ENABLED=false
DISCOVERY_CRON_RADIUS_KM=50

# ------------------------------------------------------------------------------
# 2. PRODUCTION RENDER CONFIGURATION (Add these under Render Environment tab)
# ------------------------------------------------------------------------------
# PORT=5000
# NODE_ENV=production
# CLIENT_URL=https://fairway-ai-crm.onrender.com
# DATABASE_URL=postgresql://fairway_crm_user:PASSWORD@HOST:PORT/fairway_crm_db_v2?sslmode=require
# JWT_SECRET=generate_a_secure_64_char_random_secret_for_production
# JWT_EXPIRES_IN=7d
# INTELLIGENCE_API_URL=https://fairway-intelligence.onrender.com
# INTELLIGENCE_API_KEY=your_shared_intelligence_secret_key
# DISCOVERY_CRON_ENABLED=false
# DISCOVERY_CRON_RADIUS_KM=50

