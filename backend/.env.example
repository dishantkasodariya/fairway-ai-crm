# ==============================================================================
# FAIRWAY CRM BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL CONFIGURATION (Use this in backend/.env for localhost)
# ------------------------------------------------------------------------------
# PORT=5000
# NODE_ENV=development
# CLIENT_URL=http://localhost:5173

# Local PostgreSQL Database (Default port 5432)
# Replace with your local postgres password:
# DATABASE_URL="postgresql://postgres:Dishant%401012@localhost:5432/fairway_crm?schema=public"

# JWT Secret for local dev
# JWT_SECRET="fairway_jwt_dev_secret_key_123456"
# JWT_EXPIRES_IN="7d"

# Fairway Company Intelligence API (run separately from /intelligence, see intelligence/README.md)
# INTELLIGENCE_API_URL="http://localhost:8000"
# INTELLIGENCE_API_KEY="change_me"  # must match API_KEY in intelligence/.env


# ------------------------------------------------------------------------------
# 2. PRODUCTION RENDER CONFIGURATION (Add these under Render Environment tab)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
CLIENT_URL=*
DATABASE_URL=postgresql://fairway_user:oswApjFxNHlkhlSlIFToIGQYlksoC6KY@dpg-daa5rqss728c73ffk090-a/fairway_crm
JWT_SECRET=fairway_jwt_super_secret_production_key_2026
JWT_EXPIRES_IN=7d
INTELLIGENCE_API_URL=https://fairway-intelligence-api.onrender.com
INTELLIGENCE_API_KEY=change_me

# Monthly AI discovery around every warehouse that has a manager (spends Google Places credits; off unless true)
DISCOVERY_CRON_ENABLED=false
DISCOVERY_CRON_RADIUS_KM=50
