{
  "name": "fairway-crm-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API server for Fairway CRM",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "OTEL_SERVICE_NAME=${OTEL_SERVICE_NAME:-fairway-backend} OTEL_TRACES_EXPORTER=${OTEL_TRACES_EXPORTER:-otlp} node --import @opentelemetry/auto-instrumentations-node/register dist/server.js",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^7.2.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.16",
    "pg": "^8.13.3",
    "supertest": "^7.3.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
