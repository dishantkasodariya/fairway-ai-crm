{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "default",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "tailwind.config.js",
    "css": "src/index.css",
    "baseColor": "slate",
    "cssVariables": true,
    "prefix": ""
  },
  "aliases": {
    "components": "@/modules/core/components/ui",
    "utils": "@/modules/core/lib/utils",
    "ui": "@/modules/core/components/ui",
    "lib": "@/modules/core/lib",
    "hooks": "@/modules/core/hooks"
  },
  "iconLibrary": "lucide",
  "registries": {
    "@shadcnblocks": "https://shadcnblocks.com/r/{name}.json",
    "@reui": "https://reui.io/r/{style}/{name}.json"
  }
}
